<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ page.title }}</title>
    <link rel="stylesheet" href="{{ root }}/assets/root.css" />
    <link rel="stylesheet" href="{{ root }}/assets/style.css" />
    <link rel="stylesheet" href="{{ root }}/assets/navbar.css" />
    <link rel="stylesheet" href="{{ root }}/assets/highlight/nord.min.css" />
    <link rel="stylesheet" href="{{ root }}/assets/markdown-body.css" />
    <script src="{{ root }}/assets/highlight/highlight.min.js"></script>
  </head>
  <body>
    {% include "partials/navbar.j2" %}
    <div class="card">
      <div class="title" id="titlePlaceholder">{{ page.title }}</div>
      <div class="text-container{% if copy %} markdown-frame{% endif %}">
        {% if copy %}
        <button type="button" class="markdown-copy-btn" id="copyMarkdown" aria-label="Copy markdown source" title="Копировать">
          <svg class="markdown-copy-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <svg class="markdown-copy-ghost" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
        </button>
        <textarea id="markdownSource" class="markdown-source" readonly hidden>{{ source }}</textarea>
        {% endif %}
        <div class="markdown-body">{{ content }}</div>
      </div>
    </div>
    <script>
      hljs.highlightAll();
    </script>
    {% if copy %}
    <script src="{{ root }}/assets/markdown-copy.js"></script>
    {% endif %}
  </body>
</html>
